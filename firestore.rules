rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Courses collection: public can read active courses, admin manages them
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // Registrations collection: trainees can submit and check status, admin reviews them
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Settings collection: public can read center info, admin manages settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
